# Jyotir backend
APP_ENV=development
# Leave empty for the local SQLite fallback.
# DATABASE_URL=postgresql://jyotir:jyotir@localhost:5432/jyotir

ASTROLOGY_API_KEY=

# LLM API Configuration (Free tier: Groq recommended)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# (Optional fallback) DeepSeek or other OpenAI-compatible providers:
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1

CORS_ORIGINS=["http://localhost:3000", "https://jyotir.builtbyanant.site"]

SESSION_DAYS=30
READING_LIMIT_DAILY=3
CHAT_LIMIT_HOURLY=30
LOCATION_LIMIT_MINUTE=30
GENERATION_MAX_ATTEMPTS=3
GENERATION_LEASE_SECONDS=240
