# Jyotir Backend — Environment Variables
# Copy to .env and fill in your keys

# ── App ──────────────────────────────────────────────
SECRET_KEY=generate-a-random-secret-key-here
APP_ENV=production

# ── Database ─────────────────────────────────────────
# Local: leave blank for SQLite auto-detection
# Render: set automatically via DATABASE_URL env var
# DATABASE_URL=postgresql://user:pass@host:5432/jyotir

# ── Astrology API ────────────────────────────────────
# Get your key at https://www.astrologyapi.com
ASTROLOGY_API_KEY=***

# ── LLM (DeepSeek) ──────────────────────────────────
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=***

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
