{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noAutofocus": "off",
				"useAriaPropsSupportedByRole": "off",
				"useButtonType": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noExplicitAny": "off",
				"noUnknownAtRules": "off",
				"useIterableCallbackReturn": "off"
			}
		}
	}
}
